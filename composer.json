{
    "name": "modularous/modularous",
    "type": "project",
    "description": "The boilerplate laravel application for the Modularous toolkit.",
    "keywords": ["modularous", "toolkit"],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^11.31",
        "laravel/sanctum": "^3.3|^4.0",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.2",
        "unusualify/modularous": "^11.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^2.0",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php artisan vendor:publish --provider='Modularous\\Modularous\\LaravelServiceProvider'"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan modularous:flush"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pint": "vendor/bin/pint",
        "pint:test": "vendor/bin/pint --test",
        "pint:bail": "vendor/bin/pint --bail",
        "pint:dirty": "vendor/bin/pint --dirty",
        "pint:repair": "vendor/bin/pint --repair",
        "pint:verbose": "vendor/bin/pint -v",
        "reinstall": [
            "@php artisan migrate:reset",
            "@php artisan modularous:install --default --db-process"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
